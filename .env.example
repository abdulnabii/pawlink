# ==========================================
# PAWLINK PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# NEXT.JS & APP ENVIRONMENT
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# SUPABASE MANAGED POSTGRESQL (Prisma ORM)
# Transaction Pooler URL (Port 6543) for application queries
DATABASE_URL="file:./dev.db"
# Direct Connection URL (Port 5432) for Prisma migrations
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# SUPABASE AUTH & STORAGE
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# SECURITY & PRIVACY
JWT_SECRET="pawlink_jwt_super_secret_key_change_in_production_2026"
IP_HASH_SALT="pawlink_salt_928172918274_2026"

# WHATSAPP NOTIFICATION PROVIDERS
WHATSAPP_PROVIDER="mock" # "mock" | "twilio" | "meta"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
META_WHATSAPP_TOKEN=""
META_PHONE_NUMBER_ID=""

# EMAIL NOTIFICATION PROVIDERS
EMAIL_PROVIDER="mock" # "mock" | "resend" | "smtp"
RESEND_API_KEY=""
EMAIL_FROM="PawLink Recovery Alerts <alerts@pawlink.pet>"
